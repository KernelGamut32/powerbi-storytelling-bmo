{
  "name": "Ridgemere",
  "dataColors": [
    "#0B2A4A",
    "#1F7A8C",
    "#E8A33D",
    "#7A8FA6",
    "#8C5E9B",
    "#2E7D5B",
    "#C0392B",
    "#BFC9D6",
    "#4F9DAE",
    "#F2C57C",
    "#3D5A80",
    "#B08BBB"
  ],
  "good": "#2E7D5B",
  "neutral": "#E8A33D",
  "bad": "#C0392B",
  "maximum": "#0B2A4A",
  "center": "#7FA1C3",
  "minimum": "#DCE6F0",
  "null": "#EEF1F4",
  "foreground": "#1F2A37",
  "foregroundNeutralSecondary": "#5B6B7C",
  "foregroundNeutralTertiary": "#A7B2BE",
  "background": "#FFFFFF",
  "backgroundLight": "#F5F7FA",
  "backgroundNeutral": "#D9DFE6",
  "tableAccent": "#0B2A4A",
  "hyperlink": "#1F7A8C",
  "textClasses": {
    "callout": {
      "fontSize": 28,
      "fontFace": "Segoe UI Semibold",
      "color": "#0B2A4A"
    },
    "title": {
      "fontSize": 12,
      "fontFace": "Segoe UI Semibold",
      "color": "#1F2A37"
    },
    "header": {
      "fontSize": 11,
      "fontFace": "Segoe UI Semibold",
      "color": "#1F2A37"
    },
    "label": {
      "fontSize": 10,
      "fontFace": "Segoe UI",
      "color": "#5B6B7C"
    }
  },
  "visualStyles": {
    "*": {
      "*": {
        "title": [
          {
            "fontColor": {
              "solid": {
                "color": "#1F2A37"
              }
            },
            "fontSize": 12,
            "fontFamily": "Segoe UI Semibold",
            "titleWrap": true
          }
        ],
        "background": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "transparency": 0
          }
        ],
        "border": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#D9DFE6"
              }
            },
            "radius": 6
          }
        ],
        "dropShadow": [
          {
            "show": false
          }
        ]
      }
    },
    "page": {
      "*": {
        "background": [
          {
            "color": {
              "solid": {
                "color": "#F5F7FA"
              }
            },
            "transparency": 0
          }
        ],
        "outspace": [
          {
            "color": {
              "solid": {
                "color": "#E9EDF2"
              }
            },
            "transparency": 0
          }
        ]
      }
    },
    "lineChart": {
      "*": {
        "lineStyles": [
          {
            "strokeWidth": 3
          }
        ]
      }
    },
    "slicer": {
      "*": {
        "border": [
          {
            "show": false
          }
        ],
        "background": [
          {
            "show": false
          }
        ]
      }
    },
    "textbox": {
      "*": {
        "border": [
          {
            "show": false
          }
        ],
        "background": [
          {
            "show": false
          }
        ]
      }
    },
    "actionButton": {
      "*": {
        "border": [
          {
            "show": false
          }
        ],
        "background": [
          {
            "show": false
          }
        ]
      }
    },
    "shape": {
      "*": {
        "border": [
          {
            "show": false
          }
        ],
        "background": [
          {
            "show": false
          }
        ]
      }
    },
    "pageNavigator": {
      "*": {
        "border": [
          {
            "show": false
          }
        ],
        "background": [
          {
            "show": false
          }
        ]
      }
    }
  }
}